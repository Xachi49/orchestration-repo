# Read-only GitHub token for GitHubReadOnlyAdapter.
# Minimum privilege (contents:read / public repo read). Never commit a real token.
# The local fake stack (npm start) does not require this variable.
GITHUB_TOKEN=

# Optional live OpenAI planning (Phase 4). Default npm start / npm test use FakePlanningModel.
# Never commit a real key. Do not enable for CI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
