{
  "name": "orchestrator-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-grounded, policy-governed orchestration engine — Phase 12 production readiness",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'src/infrastructure/postgres/postgres.*.test.ts'",
    "test:watch": "vitest --exclude 'src/infrastructure/postgres/postgres.*.test.ts'",
    "test:postgres": "node scripts/test-postgres.mjs",
    "db:migrate": "node --import tsx src/infrastructure/postgres/cli.ts migrate",
    "db:status": "node --import tsx src/infrastructure/postgres/cli.ts status",
    "start": "node --import tsx src/runtime/main.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "openai": "^4.104.0",
    "pg": "^8.23.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
